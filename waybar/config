// -*- mode: jsonc -*-
{
    "layer": "top",
    "height": 38,
    "fixed-center": true,
    "spacing": 8,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/media"
    ],
    "modules-right": [
        "idle_inhibitor",
        "cpu",
        "battery",
        "pulseaudio",
        "network",
        "custom/bluetooth",
        "tray",
        "clock"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "active-only": false
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": true
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}{capacity}%",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰃨",
        "format-plugged": "{capacity}% ",
        "format-icons": ["", "", "", "", ""]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "󰅶 {icon}",
        "format-muted": "󰅶",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰊗",
        "format-disconnected": "⚠",
        "tooltip-format": "{essid} ({signalStrength}%) {ifname}"
    },
    "custom/bluetooth": {
        "exec": "$HOME/.config/waybar/bluetooth.py 2> /dev/null",
        "interval": 30,
        "return-type": "json",
        "escape": true,
        "on-click": "blueman-manager",
        "format": "{}"
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "format": "{:%H:%M}"
    },
    "custom/media": {
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null",
        "exec-if": "which playerctl",
        "interval": 3.0,
        "escape": true,
        "persistent": true,
        "format": "{}",
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    }
}
