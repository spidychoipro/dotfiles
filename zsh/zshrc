# Starship prompt
eval "$(starship init zsh)"

export PATH="$HOME/.opencode/bin:$PATH"

export TERM=xterm-256color
export COLORTERM=truecolor

export LANG=ko_KR.UTF-8
export LC_MESSAGES=en_US.UTF-8

zmodload zsh/complist

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={a-zA-Z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select=0

autoload -Uz compinit
compinit -i

setopt AUTO_MENU
setopt CORRECT
setopt CORRECT_ALL

CORRECT_IGNORE="opencode"

alias ls='ls --color=auto'
alias clear='clear && printf "\033[3J"'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# fzf: 정확 부분일치(exact)로 검색 — "cube" 검색 시 cube가 그대로 포함된 것만
# ctrl+t: 파일 검색 / ctrl+r: 이전 명령 검색 / alt+c: 디렉터리 이동 / **<TAB>: 경로 완성
export FZF_DEFAULT_OPTS='--exact --height 40% --layout=reverse --border'
source <(fzf --zsh)

# fzf 미리보기: 파일 내용(bat), 디렉터리 트리(eza)로 표시
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range=:100 {} 2>/dev/null || eza --tree --level=2 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 {} 2>/dev/null'"

# eza: ls 대체 (ls 입력 시 색상+아이콘 출력, tree로 디렉터리 구조)
alias ls='eza --icons --group-directories-first'
alias la='eza --icons --all --group-directories-first'
alias lt='eza --icons --tree --level=2 --group-directories-first'
alias ll='eza --icons --long --git --group-directories-first'

# bat: cat 대체 (구문 하이라이트)
alias cat='bat --paging=never'

# zoxide: 똑똑한 cd — "z 폴더이름"으로 자주 가는 곳에 즉시 이동
eval "$(zoxide init zsh)"

# rm 실행 시 항상 삭제 여부 확인 (-i: interactive)
alias rm='rm -i'

# 디렉터리나 파일이 3개 이상일 때 한 번 더 크게 경고받고 싶다면 (선택 사항)
